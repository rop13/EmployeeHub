<?xml version="1.0"?>
<ruleset name="Project">
  <description>Project coding standard (PSR12)</description>

  <!-- Use PSR12 as baseline -->
  <rule ref="PSR12"/>

  <!-- Files to scan -->
  <file>src</file>
  <file>tests</file>

  <!-- Only src/ and tests/ are declared as <file> above, so vendor/ and
       var/ are never in scan scope regardless — no exclude-pattern needed.
       (A `*/var/*` exclude-pattern actively breaks scanning under Docker:
       PHPCS 4's exclude-pattern matches the absolute path, and this
       project's container WORKDIR is /var/www/symfony, so `*/var/*` would
       exclude every file in the project.) -->
</ruleset>
