{% extends 'base.html.twig' %}

{% block title %}Client registered — EmployeeHub{% endblock %}

{% block body %}
<nav class="navbar navbar-expand navbar-light bg-light border-bottom mb-4">
    <div class="container">
        <a href="{{ path('app_dashboard') }}" class="navbar-brand"><i class="bi bi-person-badge"></i> EmployeeHub</a>
    </div>
</nav>
<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="alert alert-danger">
                <h1 class="h5"><i class="bi bi-exclamation-triangle-fill"></i> Save this secret now — it will never be shown again</h1>
                <p class="mb-0">
                    Leaving or refreshing this page discards the plaintext secret permanently. Only its
                    hash is stored. If it is lost, this client must be deactivated and re-registered.
                </p>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <h2 class="h6">"{{ client.name }}" was registered</h2>
                    <dl class="row mb-0">
                        <dt class="col-sm-3">Client ID</dt>
                        <dd class="col-sm-9"><code>{{ client.identifier }}</code></dd>

                        <dt class="col-sm-3">Client secret</dt>
                        <dd class="col-sm-9"><code>{{ plainSecret }}</code></dd>

                        <dt class="col-sm-3">Redirect URI</dt>
                        <dd class="col-sm-9">
                            {% for redirectUri in client.redirectUris %}
                                <div>{{ redirectUri }}</div>
                            {% endfor %}
                        </dd>
                    </dl>
                </div>
            </div>

            <a href="{{ path('app_oauth_client_index') }}" class="btn btn-primary">I have saved it — back to clients</a>
        </div>
    </div>
</div>
{% endblock %}
