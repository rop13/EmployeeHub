{% extends 'base.html.twig' %}

{% block title %}People — EmployeeHub{% endblock %}

{% block body %}
<nav class="navbar navbar-expand navbar-light bg-light border-bottom mb-4">
    <div class="container">
        <a href="{{ path('app_dashboard') }}" class="navbar-brand"><i class="bi bi-person-badge"></i> EmployeeHub</a>
    </div>
</nav>
<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h4 mb-0">People</h1>
        <a href="{{ path('app_person_new') }}" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-circle"></i> Add person
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    <table class="table table-hover bg-white">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            {% for person in people %}
                <tr>
                    <td>{{ person.fullName }}</td>
                    <td>{{ person.email }}</td>
                    <td>{{ person.role }}</td>
                    <td>{{ person.isActive ? 'Active' : 'Deactivated' }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4" class="text-center text-muted">No people yet.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
